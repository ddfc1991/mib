<?xml version="1.0" encoding="utf-8"?>
<!--
  destiny — monochrome layer for Android 13+ Themed Icons.

  The themed-icon pipeline throws colour away and re-tints the ALPHA
  channel with a colour picked from the user's wallpaper, so this file
  must be a flat white silhouette with no face: a face drawn in white
  would vanish, and VectorDrawable has no "clear" blend to punch eyes
  out of an overlapping body. Silhouette only is also what the platform
  expects here — the cloud outline alone is recognisable at 24dp.

  Geometry is the same cloud as the coloured foreground (three puffs on
  a rounded base, the four shapes overlapping so no hairline shows),
  so the themed icon and the normal icon are one mark, not two.

  Safe circle: centre (54,54) radius 33; farthest body point is
  (82,57.5) at 28.0, so no mask clips it.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M27,57.5 A12,12 0 1 0 51,57.5 A12,12 0 1 0 27,57.5 Z" />
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M40,48 A15,15 0 1 0 70,48 A15,15 0 1 0 40,48 Z" />
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M60,57.5 A11,11 0 1 0 82,57.5 A11,11 0 1 0 60,57.5 Z" />
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M40.25,57.5 H69.75 A7.25,7.25 0 0 1 77,64.75 V64.75
            A7.25,7.25 0 0 1 69.75,72 H40.25 A7.25,7.25 0 0 1 33,64.75 V64.75
            A7.25,7.25 0 0 1 40.25,57.5 Z" />
</vector>

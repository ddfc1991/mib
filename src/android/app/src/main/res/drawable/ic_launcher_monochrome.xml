<?xml version="1.0" encoding="utf-8"?>
<!--
  destiny — monochrome layer for Android 13+ Themed Icons.

  The themed icon pipeline throws away colour and re-tints a silhouette
  from the user's wallpaper palette, so this file must be a FLAT SINGLE
  COLOUR shape (solid white; the system applies its own tint at runtime).

  It is the same slab D as the coloured foreground, but drawn as the
  letter itself rather than as a knockout: outer D ring, counter
  punched out with evenOdd. Keeping the exact same geometry as the
  coloured icon means the themed icon and the normal icon are the same
  logo, not two different marks (the old M had this problem).

  Safe circle: centre (54,54) radius 33. Outer D bbox 32..76 x 30..78,
  farthest corner sqrt(22^2+24^2) = 32.6 <= 33, so nothing is clipped
  under a circular or squircle mask.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path
        android:fillColor="#FFFFFFFF"
        android:fillType="evenOdd"
        android:pathData="M32,30 H52 A24,24 0 0 1 52,78 H32 Z M47,41 H52 A13,13 0 0 1 52,67 H47 Z" />
</vector>

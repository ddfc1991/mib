<?xml version="1.0" encoding="utf-8"?>
<!--
  destiny — monochrome layer for Android 13+ Themed Icons.

  Silhouette only, flat white: the themed-icon pipeline keeps the ALPHA
  channel and re-tints it, so a face drawn in white would disappear, and
  VectorDrawable has no clear blend to punch eyes out of overlapping shapes.

  Same cloud, same off-centre placement as the coloured foreground, so the
  themed icon and the normal icon are clearly one mark.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M8,74 A16,16 0 1 0 40,74 A16,16 0 1 0 8,74 Z" />
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M28,58 A20,20 0 1 0 68,58 A20,20 0 1 0 28,58 Z" />
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M53,74 A15,15 0 1 0 83,74 A15,15 0 1 0 53,74 Z" />

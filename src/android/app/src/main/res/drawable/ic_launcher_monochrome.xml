        android:fillColor="#FFFFFFFF"
        android:pathData="M22,74 H58 A14,14 0 0 1 72,88 V86 A14,14 0 0 1 58,100 H22 A14,14 0 0 1 8,86 V88 A14,14 0 0 1 22,74 Z" />

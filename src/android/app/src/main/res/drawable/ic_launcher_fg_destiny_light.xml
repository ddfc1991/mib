<?xml version="1.0" encoding="utf-8"?>
<!--
  destiny — launcher foreground, DARK ("auto" + "Dark" pin).

  命运星轨 (Destiny orbit): 一条紫青轨道环 + 中心白色光核 + 右上青色星点。
  Theme-independent (same in light/dark): the icon is a fixed brand asset.

  Geometry (108dp canvas; the safe circle is centre 54,54 r 33):
    orbit ring  centre (54,54), outer ellipse rx27 ry11.5, inner rx20.5 ry5,
                rotated -24deg about (54,54), evenOdd -> ring
    core        circle (54,54) r 7.5, white
    star        circle (78.7,54) r 2.8 in the rotated group -> lands upper-right

  Everything sits inside the 72dp window (18..90) so no mask crops it.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group
        android:rotation="-24"
        android:pivotX="54"
        android:pivotY="54">
        <path
            android:fillColor="#7C6CFF"
            android:fillType="evenOdd"
            android:pathData="M27,54 A27,11.5 0 1,1 81,54 A27,11.5 0 1,1 27,54 Z M33.5,54 A20.5,5 0 1,1 74.5,54 A20.5,5 0 1,1 33.5,54 Z" />
        <path
            android:fillColor="#00D4A0"
            android:pathData="M75.9,54 A2.8,2.8 0 1,1 81.5,54 A2.8,2.8 0 1,1 75.9,54 Z" />
    </group>

    <path
        android:fillColor="#FFFFFF"
        android:pathData="M46.5,54 A7.5,7.5 0 1,1 61.5,54 A7.5,7.5 0 1,1 46.5,54 Z" />
</vector>

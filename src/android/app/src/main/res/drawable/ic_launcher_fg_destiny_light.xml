<?xml version="1.0" encoding="utf-8"?>
<!--
  destiny — launcher foreground, LIGHT (pinned Light variant only).

  Same cloud character, re-coloured for the cream ground (#FAF9F5):
  the body has to go dark to stay visible on it, so the body is rust
  copper and the face is dark brown. Everything else (geometry, overlap
  rules, safe circle) is identical to the dark file — the two icons are
  one mark in two colourways, not two different mascots.

  Layer contract: background = flat cream, foreground = character only,
  nothing punched out. See ic_launcher_fg_destiny_dark.xml for the full
  geometry notes.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- copper halo: on a light ground it reads as a warm cast, not a glow -->
    <path android:pathData="M24.5,54 A30,30 0 1 0 84.5,54 A30,30 0 1 0 24.5,54 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54.5"
                android:centerY="54"
                android:gradientRadius="30"
                android:tileMode="clamp">
                <item android:offset="0" android:color="#38D97F5C" />
                <item android:offset="0.62" android:color="#14D97F5C" />
                <item android:offset="1" android:color="#00D97F5C" />
            </gradient>
        </aapt:attr>
    </path>

    <group android:name="body">
        <path
            android:fillColor="#D97F5C"
            android:pathData="M27,57.5 A12,12 0 1 0 51,57.5 A12,12 0 1 0 27,57.5 Z" />
        <path
            android:fillColor="#D97F5C"
            android:pathData="M40,48 A15,15 0 1 0 70,48 A15,15 0 1 0 40,48 Z" />
        <path
            android:fillColor="#D97F5C"
            android:pathData="M60,57.5 A11,11 0 1 0 82,57.5 A11,11 0 1 0 60,57.5 Z" />
        <path
            android:fillColor="#D97F5C"
            android:pathData="M40.25,57.5 H69.75 A7.25,7.25 0 0 1 77,64.75 V64.75
                A7.25,7.25 0 0 1 69.75,72 H40.25 A7.25,7.25 0 0 1 33,64.75 V64.75
                A7.25,7.25 0 0 1 40.25,57.5 Z" />
    </group>

    <path
        android:fillColor="#66F6C9AE"
        android:pathData="M34.4,63.6 A4.2,2.7 0 1 0 42.8,63.6 A4.2,2.7 0 1 0 34.4,63.6 Z" />
    <path
        android:fillColor="#66F6C9AE"
        android:pathData="M66.6,63.6 A4.2,2.7 0 1 0 75,63.6 A4.2,2.7 0 1 0 66.6,63.6 Z" />

    <path
        android:fillColor="#3A1E12"
        android:pathData="M42.9,59 A2.6,2.6 0 1 0 48.1,59 A2.6,2.6 0 1 0 42.9,59 Z" />
    <path
        android:fillColor="#3A1E12"
        android:pathData="M61.4,59 A2.6,2.6 0 1 0 66.6,59 A2.6,2.6 0 1 0 61.4,59 Z" />
    <path
        android:fillColor="#00000000"
        android:strokeColor="#3A1E12"
        android:strokeWidth="1.8"
        android:strokeLineCap="round"
        android:pathData="M51,63.4 Q54.7,67 58.4,63.4" />
</vector>

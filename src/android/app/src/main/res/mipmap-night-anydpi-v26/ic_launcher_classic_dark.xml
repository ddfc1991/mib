<?xml version="1.0" encoding="utf-8"?>
<!--
  destiny — launcher icon, pinned DARK

  The cloud character in its cream colourway on an ink ground. Same
  geometry as the light variant, only the body/face colours change.
  Non-night resources so a pinned Dark icon stays dark while the system
  is in light mode.

  Layer contract (changed with the cloud mark): the FOREGROUND drawable
  is the cloud character only, transparent elsewhere and centred in the
  safe circle; the background below is a flat ink ground. Nothing is
  punched out of the foreground, so the ground colour can change on its
  own without editing the character.

  No <inset> wrapper: the character is already drawn inside the 72dp
  safe zone of its own 108dp canvas.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_bg_force_dark" />
    <foreground android:drawable="@drawable/ic_launcher_fg_destiny_dark" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>

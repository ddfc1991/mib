<?xml version="1.0" encoding="utf-8"?>
<!--
  destiny — launcher icon, pinned LIGHT

  The cloud character in its rust colourway on a cream ground.
  [T-android-light-icon-preview-night-leak] Both the colour and the
  drawable are non-night resources, so pinning Light stays light even
  on a dark-mode device.

  Layer contract (changed with the cloud mark): the FOREGROUND drawable
  is the cloud character only, transparent elsewhere and centred in the
  safe circle; the background below is a flat ink ground. Nothing is
  punched out of the foreground, so the ground colour can change on its
  own without editing the character.

  No <inset> wrapper: the character is already drawn inside the 72dp
  safe zone of its own 108dp canvas.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_bg_force_light" />
    <foreground android:drawable="@drawable/ic_launcher_fg_destiny_light" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>

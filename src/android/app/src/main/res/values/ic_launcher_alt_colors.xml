<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- T-android-dynamic-app-icon: explicit light/dark grounds for the
         forced-mode alternate icons. These do NOT swap with the system
         theme - they are the "always light" / "always dark" choices the
         user can pin in Settings -> Appearance -> App Icon.

         Each value here is also the colour the letter D is punched out
         to in the matching foreground sheet, so the pair must move
         together:
           force_light  <-> drawable/ic_launcher_fg_destiny_light
           force_dark   <-> drawable/ic_launcher_fg_destiny_dark -->
    <color name="ic_launcher_bg_force_light">#FAF9F5</color>
    <color name="ic_launcher_bg_force_dark">#07070A</color>
</resources>

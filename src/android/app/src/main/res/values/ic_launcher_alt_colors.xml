<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- T-android-dynamic-app-icon: explicit light/dark grounds for the
         forced-mode alternate icons. These do NOT swap with the system
         theme - they are the "always light" / "always dark" choices the
         user can pin in Settings -> Appearance -> App Icon.

         Since the cloud mark these are plain backdrops: nothing is
         punched out of the foreground, so a ground can be changed on
         its own. They still pair with a specific colourway, because the
         character's body colour is picked to contrast with it:
           force_light  <-> drawable/ic_launcher_fg_destiny_light (rust)
           force_dark   <-> drawable/ic_launcher_fg_destiny_dark  (cream) -->
    <color name="ic_launcher_bg_force_light">#FAF9F5</color>
    <color name="ic_launcher_bg_force_dark">#07070A</color>
</resources>

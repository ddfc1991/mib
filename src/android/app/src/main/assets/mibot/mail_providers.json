      "address": "{{address}}",
      "password": "{{pass}}"
     },
     "save": {
      "token": "$.token"
     }
    }
   ],
   "list": {
    "method": "GET",
    "url": "https://api.mail.tm/messages",
    "headers": {
     "Authorization": "Bearer {{token}}"
